OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=ChessBench

# Deprecated fallback aliases (will be removed in a future release)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Optional override. If unset, ChessBench auto-detects Stockfish from PATH
# (for example /opt/homebrew/bin/stockfish or /usr/local/bin/stockfish).
# STOCKFISH_PATH=/opt/homebrew/bin/stockfish
DATABASE_URL=sqlite:////app/data/arena.db
ANALYSIS_DEPTH=18
STOCKFISH_THREADS=4
STOCKFISH_HASH_MB=256
MOVE_DELAY_SECONDS=1.5
MAX_MOVES_PER_SIDE=150
LLM_MAX_RETRIES=5
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
# Optional OpenRouter reasoning effort (none|minimal|low|medium|high).
# Set a single value here to keep all LLM players on equal footing.
LLM_REASONING_EFFORT=low
